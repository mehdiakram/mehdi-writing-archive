{
  "enabled": true,
  "max_file_size_bytes": 10485760,
  "allowed_mime_types": [
    "image/jpeg",
    "image/png",
    "image/webp",
    "image/gif",
    "image/svg+xml"
  ],
  "allowed_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".webp",
    ".gif",
    ".svg"
  ],
  "download_featured_images": true,
  "download_embedded_images": true,
  "allowed_domains": [
    "royaltechbd.com",
    "www.royaltechbd.com",
    "shamokaldarpon.com",
    "www.shamokaldarpon.com",
    "secure.gravatar.com"
  ],
  "disallow_private_ips": true,
  "request_timeout_seconds": 25,
  "max_retries": 3
}
